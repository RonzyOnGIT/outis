{
  "name": "@nobody/engine",
  "version": "0.1.0",
  "description": "Nobody engine: local PII detection, consistent pseudonymization and writing-style obfuscation. Runs fully on-device.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:ner": "NOBODY_NER_IT=1 vitest run test/ner.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mlc-ai/web-llm": "^0.2.88"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
